<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="jp.oist.abcvlib.fragments.PidGuiFragament"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textViewSetPoint"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/set_point_deg"
        android:textAlignment="center" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarSetPoint"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.1"
        android:value="6.4"
        android:valueFrom="-10.0"
        android:valueTo="10.0" />

    <TextView
        android:id="@+id/textViewTiltP"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/tilt_p" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarTiltP"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.001"
        android:value="-0.0"
        android:valueFrom="-0.4"
        android:valueTo="0.0" />

    <TextView
        android:id="@+id/textViewTiltD"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/tilt_d" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarTiltD"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.0001"
        android:value="0.01"
        android:valueFrom="0.0"
        android:valueTo="0.04" />

    <TextView
        android:id="@+id/textViewWheelSpeedP"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/speed_p" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarWheelSpeedP"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.00001"
        android:value="0.0"
        android:valueFrom="0.0"
        android:valueTo="0.01" />

    <TextView
        android:id="@+id/textViewExponentialWeight"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/expWeight" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarExponentialWeight"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.001"
        android:value="0.25"
        android:valueFrom="0.0"
        android:valueTo="1.0" />

    <TextView
        android:id="@+id/textViewMaxAbsTilt"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/maximum_absolute_tilt_angle" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seekBarMaxAbsTilt"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:stepSize="0.1"
        android:value="15.0"
        android:valueFrom="0.0"
        android:valueTo="30.0" />

</LinearLayout>
